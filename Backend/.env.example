# Never commit your real key. Copy this file to .env for local development.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000
LOG_LEVEL=INFO

# Same-origin deployment does not need CORS. For separate frontend hosting,
# set this to comma-separated trusted browser origins.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Lightweight per-process abuse protection.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=10
